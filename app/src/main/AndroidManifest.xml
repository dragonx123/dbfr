<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Voice input / output -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Downloading a model file, and/or talking to an Ollama server (see OllamaChatBackend.kt) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Device-control tools (see JarvisTools.kt). All are opened via user-facing
         intents (dialer, SMS composer, calendar, maps) so no SEND_SMS / CALL_PHONE
         / WRITE_CALENDAR runtime permission is required for the default tool set. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Torch/flashlight control does not require a runtime prompt beyond CAMERA on
         most OEMs, but some require it explicitly for CameraManager#setTorchMode. -->

    <!-- Optional: lets the wake-word listener keep running while the screen is off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- Required so the LiteRT-LM GPU backend can load its native OpenCL/vndk
             delegate libraries on devices that provide them. Both are optional; the
             engine falls back to CPU when unavailable. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".voice.WakeWordService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Keeps a voice conversation running (and the mic usable) while the
             app is backgrounded or the screen is off. See VoiceSessionService. -->
        <service
            android:name=".voice.VoiceSessionService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- Required from Android 14 on: MediaProjection refuses to create a
             virtual display unless a foregroundServiceType="mediaProjection"
             service is already running. See ScreenCaptureService. -->
        <service
            android:name=".control.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Optional, user-enabled in Android's Accessibility settings: lets Jarvis
             read the current screen and operate it (back/home, scroll, tap by label). -->
        <service
            android:name=".control.JarvisAccessibilityService"
            android:exported="false"
            android:label="Jarvis screen control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
