<?xml version="1.0" encoding="utf-8"?>
<!--
  Ollama servers are commonly run on a LAN box without TLS (e.g.
  http://192.168.1.50:11434), and the user supplies that address themselves
  in Settings, so cleartext traffic needs to be allowed. This does not
  affect the on-device LiteRT-LM backend, which makes no network calls.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
